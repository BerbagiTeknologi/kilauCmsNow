      \"<span class=sf-dump-key>des_disclaimer</span>\" => \"\"\"
        <span class=sf-dump-str title=\"460 characters\">Penggalangan dana ini diselenggarakan oleh Kilau Indonesia dengan persetujuan resmi dari Pondok Pesantren Roulotul Abidin.<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
        <span class=sf-dump-str title=\"460 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
        <span class=sf-dump-str title=\"460 characters\">Seluruh donasi akan digunakan untuk pembangunan atap asrama santri.<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
        <span class=sf-dump-str title=\"460 characters\">Setiap penggunaan dana akan dilaporkan secara terbuka dan transparan. Jika terdapat kelebihan dana, akan dialihkan untuk kebutuhan pembangunan serupa.<span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
        <span class=sf-dump-str title=\"460 characters\"><span class=\"sf-dump-default sf-dump-ns\">\\r\\n</span></span>
        <span class=sf-dump-str title=\"460 characters\">Donasi yang sudah masuk tidak dapat dikembalikan dan kampanye ini bersifat sosial dan tidak bersifat komersial.</span>
        \"\"\"
      \"<span class=sf-dump-key>gambar</span>\" => \"<span class=sf-dump-str title=\"20 characters\">Campaign Program.jpg</span>\"
      \"<span class=sf-dump-key>rincian</span>\" => <span class=sf-dump-const>null</span>
