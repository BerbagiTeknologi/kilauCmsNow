      \"<span class=sf-dump-key>keterangan_dokumen</span>\" => <span class=sf-dump-const>null</span>
      \"<span class=sf-dump-key>artikel</span>\" => \"<span class=sf-dump-str title=\"918 characters\">&lt;p&gt;&lt;b&gt;Ayo Bangun Asrama Layak untuk Para Santri&lt;/b&gt;&lt;p&gt;Pondok Pesantren Roulotul Abidin tengah berjuang menyediakan tempat tinggal yang aman dan nyaman bagi para santrinya.&lt;/p&gt;&lt;p&gt;&lt;img src=&quot;/upload/1749438412_0.png&quot; style=&quot;width: 100%;&quot; data-filename=&quot;1749386015_0.png&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;Namun hingga kini, pembangunan asrama untuk mereka masih terkendala biaya. Imbasnya, &lt;b&gt;asrama pun gak jadi-jadi&lt;/b&gt;.&lt;/p&gt;&lt;p&gt;&lt;img src=&quot;/upload/1749438412_1.png&quot; data-filename=&quot;1749386015_1.png&quot; style=&quot;width: 100%;&quot;&gt;&lt;br&gt;&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;p&gt;&lt;b&gt;Menyerah bukan pilihan&lt;/b&gt;. &lt;i&gt;Tapi harapan mereka untuk atap asrama yang layak, adalah panggilan untuk kita&lt;/i&gt;.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Masalahnya&lt;/b&gt;:&lt;br&gt;Bangunan asrama yang mangkrak karena kurang biaya.&lt;br&gt;Santri terpaksa belajar di tempat seadanya.&lt;/p&gt;&lt;p&gt;&lt;b&gt;Solusinya&lt;/b&gt;:&lt;br&gt;Kita &lt;b&gt;bantu lanjutkan bangun atap asrama&lt;/b&gt;&amp;nbsp;yang kokoh dan aman untuk santri.&lt;/p&gt;&lt;p&gt;&lt;b&gt;MAU IKUT&lt;/b&gt;....???&lt;/p&gt;&lt;p&gt;&lt;/p&gt;&lt;/p&gt;<span class=\"sf-dump-default sf-dump-ns\">\\n</span></span>\"
