KM12_OUTBOX_QUEUE_CONNECTION=database
KM12_OUTBOX_QUEUE=integrations
KM12_OUTBOX_MAX_ATTEMPTS=5
KM12_OUTBOX_LOCK_SECONDS=600

SESSION_DRIVER=file
