APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

AUTH_SERVICE_URL=http://127.0.0.1:8001
AUTH_SERVICE_INTERNAL_KEY=
AUTH_SERVICE_TIMEOUT=10
AUTH_SERVICE_DEFAULT_ROLE=user
AUTH_SERVICE_APP_NAME=kilauCms
AUTH_SERVICE_LOCAL_DATABASE=klauindonesia_cms
AUTH_SERVICE_LOCAL_USER_TABLE=users

LOG_CHANNEL=stack
LOG_DEPRECATIONS_CHANNEL=null
